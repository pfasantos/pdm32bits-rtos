# Run from the repository root: doxygen Doxyfile
PROJECT_NAME           = "pdm32bits-rtos"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = README.md main
FILE_PATTERNS          = *.md *.c *.h
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
